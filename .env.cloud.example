# Backend -> SHARED cloud Firebase project. Reads and writes REAL shared data.
# cp .env.cloud.example .env.cloud   (git-ignored; never commit)
# Run backend: AGENTSHIELD_ENV_FILE=.env.cloud .venv/bin/uvicorn backend.app.main:app --port 8000
# Verify first: AGENTSHIELD_ENV_FILE=.env.cloud python scripts/check_firebase_config.py
ENVIRONMENT=development
FIREBASE_TARGET=cloud
# Supplied by the Firebase project owner. Do not guess.
FIREBASE_PROJECT_ID=<shared-firebase-project-id>
# Must repeat FIREBASE_PROJECT_ID exactly (deliberate opt-in to shared data).
FIREBASE_CLOUD_PROJECT_CONFIRM=<shared-firebase-project-id>
# Preferred: leave empty and run `gcloud auth application-default login` with
# the Google account the owner granted access to (no key file to leak).
# Otherwise: absolute path to a key OUTSIDE this repo, e.g.
#   /Users/<you>/.config/agentshield/firebase-admin.json
GOOGLE_APPLICATION_CREDENTIALS=
# Must stay empty for the cloud (also unset them in your shell).
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
DATABASE_MODE=firestore
FIREBASE_AUTH_REQUIRED=true
RATE_LIMIT_BACKEND=firestore
DEV_AUTH_IDENTITIES=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Backend -> local Firebase Emulator Suite (isolated; never touches the cloud).
# cp .env.emulator.example .env.emulator
# Start emulators: firebase emulators:start --only auth,firestore --project demo-agentshield
# Run backend:     AGENTSHIELD_ENV_FILE=.env.emulator .venv/bin/uvicorn backend.app.main:app --port 8000
ENVIRONMENT=development
FIREBASE_TARGET=emulator
# demo-* IDs are never connected to Google Cloud by the emulator.
FIREBASE_PROJECT_ID=demo-agentshield
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
DATABASE_MODE=firestore
FIREBASE_AUTH_REQUIRED=true
RATE_LIMIT_BACKEND=firestore
# Must stay empty for the emulator.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLOUD_PROJECT_CONFIRM=
DEV_AUTH_IDENTITIES=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Firestore database (the code uses the default database).
FIRESTORE_DATABASE_ID=(default)

# AgentShield dashboard configuration (reference). Vite loads .env, then
# .env.<mode> for `vite --mode <mode>`:
#   npm run dev            -> FIREBASE target from .env / .env.local (default: none)
#   npm run dev:emulator   -> .env.emulator (copy from .env.emulator.example)
#   npm run dev:cloud      -> .env.cloud    (copy from .env.cloud.example)
# Only PUBLIC Firebase web-app config belongs here. Every VITE_* value is
# shipped to browsers: never put service-account keys or Admin credentials
# here (the build fails if it detects them).
VITE_API_BASE_URL=http://127.0.0.1:8000
# none | emulator | cloud
VITE_FIREBASE_TARGET=none
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_EMULATOR_URL=
# Development without Firebase (target none): identity sent as
# X-AgentShield-Dev-User; must match backend DEV_AUTH_IDENTITIES.
VITE_DEV_IDENTITY=local-admin

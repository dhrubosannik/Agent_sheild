# Dashboard -> local Auth emulator. cp .env.emulator.example .env.emulator
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_FIREBASE_TARGET=emulator
VITE_FIREBASE_PROJECT_ID=demo-agentshield
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# The emulator accepts any API key / app ID; these are fixed local values.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_APP_ID=1:000000000000:web:emulator
VITE_DEV_IDENTITY=

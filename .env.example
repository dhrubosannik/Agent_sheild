# AgentShield backend configuration (reference). Copy to .env and edit, or use
# one of the per-target templates so emulator and cloud settings never mix:
#   .env.emulator.example -> .env.emulator   (local Firebase Emulator Suite)
#   .env.cloud.example    -> .env.cloud      (shared cloud Firebase project)
# Select a file with: AGENTSHIELD_ENV_FILE=.env.emulator  (default: .env)
# All real .env* files are git-ignored. Check a file with:
#   AGENTSHIELD_ENV_FILE=.env.emulator python scripts/check_firebase_config.py

APPLICATION_NAME=AgentShield
APPLICATION_VERSION=0.1.0
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
AGENTSHIELD_POLICY_PATH=backend/policies/default_policy.yaml
AGENTSHIELD_DATABASE_PATH=data/agentshield.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAX_REQUEST_BYTES=262144

# --- Firebase target: none | emulator | cloud -------------------------------
# none     : no Firebase; SQLite + DEV_AUTH_IDENTITIES (this default profile)
# emulator : local emulators only (see .env.emulator.example)
# cloud    : the shared project, explicit opt-in (see .env.cloud.example)
FIREBASE_TARGET=none
DATABASE_MODE=sqlite
FIREBASE_AUTH_REQUIRED=false

# Used only by emulator/cloud targets (leave empty for none):
FIREBASE_PROJECT_ID=
FIREBASE_CLOUD_PROJECT_CONFIRM=
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
# Absolute path to a service-account JSON OUTSIDE this repository, or leave
# empty to use Application Default Credentials. Never commit this file.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Rate limiting -----------------------------------------------------------
# auto | memory | firestore. Production requires firestore, or memory with
# RATE_LIMIT_SINGLE_INSTANCE=true and exactly one instance.
RATE_LIMIT_BACKEND=auto
RATE_LIMIT_SINGLE_INSTANCE=false
TRUSTED_PROXY_COUNT=0

# --- Local identities (FIREBASE_TARGET=none only) ----------------------------
# Selected per request with the X-AgentShield-Dev-User header from a loopback
# client. Never set in production (startup fails).
DEV_AUTH_IDENTITIES=local-admin:ADMIN,local-reviewer:REVIEWER,local-viewer:VIEWER
# Firestore database (the code uses the default database).
FIRESTORE_DATABASE_ID=(default)

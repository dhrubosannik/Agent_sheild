rules_version = '2';

// AgentShield Firestore Security Rules.
//
// Browsers never write security state. Approval decisions, audit records,
// chain state and rate-limit counters are written only by the FastAPI
// backend through the Firebase Admin SDK, which bypasses these rules; the
// backend therefore enforces authentication, roles and state transitions
// itself. These rules make the client SDK read-only for verified users.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : "VIEWER";
    }

    function isAdmin() {
      return role() == "ADMIN";
    }

    // User profiles (uid, email, display_name, role, email_verified, status,
    // created_at, updated_at, last_login_at) are written exclusively by the
    // FastAPI backend via the Firebase Admin SDK to enforce validation, server
    // timestamps, and role/status transitions and prevent client privilege escalation.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /security_events/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /audit_events/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /audit_transitions/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /audit_checkpoints/{checkpointId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Decisions go through POST /api/v1/approvals/{id}/decision only.
    match /approvals/{approvalId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Policy definitions and versioned audit history are written exclusively by
    // the FastAPI backend via the Firebase Admin SDK so every mutation enforces
    // schema/engine validation, monotonic versioning, server timestamps, and
    // atomic history logging without browser bypass.
    match /policies/{policyId} {
      allow read: if signedIn();
      allow write: if false;

      match /history/{versionId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /system_metadata/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    // audit_sequence_v2, audit_event_status, rate_limits and anything else:
    // backend-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

// AgentShield Firestore Security Rules.
//
// Browsers never write security state. Approval decisions, audit records,
// chain state and rate-limit counters are written only by the FastAPI
// backend through the Firebase Admin SDK, which bypasses these rules; the
// backend therefore enforces authentication, roles and state transitions
// itself. These rules make the client SDK read-only for verified users.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : "VIEWER";
    }

    function isAdmin() {
      return role() == "ADMIN";
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin() && uid != null;
      allow delete: if isAdmin();
    }

    match /security_events/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /audit_events/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /audit_transitions/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /audit_checkpoints/{checkpointId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Decisions go through POST /api/v1/approvals/{id}/decision only.
    match /approvals/{approvalId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /policies/{policyId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /system_metadata/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    // audit_sequence_v2, audit_event_status, rate_limits and anything else:
    // backend-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
